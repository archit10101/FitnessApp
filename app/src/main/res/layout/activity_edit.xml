<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">


    <TextView
        android:id="@+id/seekBar1Label"
        android:layout_width="76dp"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:padding="8dp"
        android:text="Pace"
        android:textColor="#FFFFFF"
        android:textSize="25sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.54"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <SeekBar
        android:id="@+id/seekBar1"
        android:layout_width="131dp"
        android:layout_height="17dp"
        android:max="4"
        android:min="0"
        android:paddingHorizontal="16dp"
        android:progressBackgroundTint="@color/colorPrimary"
        android:progressTint="@color/colorPrimaryDark"
        android:scaleX="0.8"
        android:scaleY="0.8"
        android:thumbTint="@color/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.296"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/seekBar1Label" />

    <TextView
        android:id="@+id/seekBar1Value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="36dp"
        android:padding="8dp"
        android:text="0"

        android:textColor="#FFFFFF"
        android:textSize="17sp"
        app:layout_constraintBottom_toBottomOf="@id/seekBar1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/seekBar1"
        app:layout_constraintTop_toTopOf="@id/seekBar1"
        app:layout_constraintVertical_bias="0.437" />

    <TextView
        android:id="@+id/seekBar2Label"
        android:layout_width="83dp"
        android:layout_height="44dp"
        android:padding="8dp"
        android:text="Count"
        android:textColor="#FFFFFF"
        android:textSize="25sp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.569"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/seekBar1" />

    <SeekBar
        android:id="@+id/seekBar2"
        android:layout_width="131dp"
        android:layout_height="17dp"
        android:max="14"
        android:min="2"
        android:paddingHorizontal="16dp"
        android:progressBackgroundTint="@color/colorPrimary"
        android:scaleX="0.8"
        android:scaleY="0.8"
        android:progressTint="@color/colorPrimary"

        android:thumbTint="@color/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.296"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/seekBar2Label" />


    <TextView
        android:id="@+id/seekBar2Value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="36dp"
        android:padding="8dp"
        android:text="0"

        android:textColor="#FFFFFF"

        android:textSize="17sp"
        app:layout_constraintBottom_toBottomOf="@id/seekBar2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/seekBar2"
        app:layout_constraintTop_toTopOf="@id/seekBar2"
        app:layout_constraintVertical_bias="0.611" />

    <TextView
        android:id="@+id/seekBar3Label"
        android:layout_width="70dp"
        android:layout_height="47dp"
        android:padding="8dp"
        android:text="Rest"
        android:textColor="#FFFFFF"

        android:textSize="25sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.522"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/seekBar2" />

    <SeekBar
        android:id="@+id/seekBar3"
        android:layout_width="131dp"
        android:layout_height="17dp"
        android:backgroundTint="@color/colorPrimaryDark"
        android:max="19"
        android:min="2"
        android:paddingHorizontal="16dp"
        android:progressBackgroundTint="@color/colorPrimary"
        android:progressTint="@color/colorPrimary"
        android:scaleX="0.8"
        android:scaleY="0.8"
        android:thumbTint="@color/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.296"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/seekBar3Label" />

    <TextView
        android:id="@+id/seekBar3Value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="36dp"
        android:padding="8dp"
        android:text="0"
        android:textColor="#FFFFFF"


        android:textSize="17sp"
        app:layout_constraintBottom_toBottomOf="@id/seekBar3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/seekBar3"
        app:layout_constraintTop_toTopOf="@id/seekBar3"
        app:layout_constraintVertical_bias="0.444" />

</androidx.constraintlayout.widget.ConstraintLayout>
