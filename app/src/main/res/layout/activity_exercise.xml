<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ExerciseActivity"
    android:id="@+id/constraintLayout">

    <me.tankery.lib.circularseekbar.CircularSeekBar
        android:id="@+id/circularSeekBar"
        android:layout_width="240dp"
        android:layout_height="250dp"
        app:cs_circle_color="#c2c2c2"
        app:cs_circle_fill="#FF000000"
        app:cs_circle_progress_color="@color/colorPrimary"
        app:cs_circle_stroke_width="15dp"
        app:cs_circle_style="round"
        app:cs_circle_x_radius="20dp"
        app:cs_circle_y_radius="20dp"
        app:cs_disable_pointer="false"
        app:cs_disable_progress_glow="false"
        app:cs_end_angle="270"
        app:cs_hide_progress_when_empty="false"
        app:cs_lock_enabled="true"
        app:cs_maintain_equal_circle="true"
        app:cs_max="101"
        app:cs_move_outside_circle="true"
        app:cs_negative_enabled="false"
        app:cs_pointer_alpha_ontouch="5"
        app:cs_pointer_angle="0"
        app:cs_pointer_color="@color/colorPrimary"
        app:cs_pointer_halo_border_width="20dp"
        app:cs_pointer_halo_color="#000000"
        app:cs_pointer_halo_color_ontouch="@color/colorPrimaryDark"
        app:cs_pointer_halo_width="5dp"
        app:cs_pointer_stroke_width="23dp"
        app:cs_progress="70"
        app:cs_use_custom_radii="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textRep1"
        android:layout_width="64dp"
        android:layout_height="26dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="48dp"
        android:background="@drawable/rounded_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="Set 1"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textRep2"
        android:layout_width="64dp"
        android:layout_height="26dp"
        android:layout_below="@id/textRep1"
        android:layout_centerHorizontal="true"
        android:background="@drawable/rounded_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="Set 2"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textRep1" />

    <TextView
        android:id="@+id/textRep3"
        android:layout_width="64dp"
        android:layout_height="26dp"
        android:layout_below="@id/textRep2"
        android:layout_centerHorizontal="true"
        android:background="@drawable/rounded_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="Set 3"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.502"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textRep2" />

    <TextView
        android:id="@+id/repsLeftText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="20"
        android:textColor="#FFFFFF"
        android:textSize="40sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.502"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textRep3" />

</androidx.constraintlayout.widget.ConstraintLayout>